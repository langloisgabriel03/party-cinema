# Copy to .env and fill in from Supabase: Project Settings -> API.
# .env is gitignored -- never commit real values. In CI these are supplied as
# repository secrets (Settings -> Secrets and variables -> Actions).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web push. This is the PUBLIC half of a VAPID keypair -- meant to ship in the client bundle,
# unlike the private half (which lives only in the notify-night Edge Function's VAPID_KEYS
# secret). Generate both together; see push.js's header comment for the generation script.
VITE_VAPID_PUBLIC_KEY=
